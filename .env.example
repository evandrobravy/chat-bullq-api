NODE_ENV=development
PORT=3001

# Public base URL of THIS API (used for Zappfy webhook callbacks + upload links)
APP_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://bravy:bravy123@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3000

# Uploads (local disk dir; defaults to ./uploads)
UPLOADS_DIR=

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=bravy
MINIO_SECRET_KEY=bravy123minio
MINIO_BUCKET=chat-bullq

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravy.com

# LLM
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# AI short-term memory (per-conversation Redis cache; blank = code defaults)
SHORT_TERM_MAX_MESSAGES=
SHORT_TERM_TTL_SECONDS=

# Automations kill-switch (true/false)
AUTOMATIONS_ENABLED=false

# Trivapp / Members area (sales catalog + access checks)
# MEMBERS_TENANT_BRAVY: per-tenant id on Trivapp. Hoje só o tenant "Bravy"
# está mapeado — vira per-org quando o produto for multi-tenant.
MEMBERS_TRIVAPP_URL=https://api.trivapp.com.br
MEMBERS_ADMIN_KEY=
MEMBERS_TENANT_BRAVY=

# Channel providers
# ZAPPFY_API_URL: base URL do provider WhatsApp (Zappfy/Uazapi)
ZAPPFY_API_URL=https://api.zappfy.io
